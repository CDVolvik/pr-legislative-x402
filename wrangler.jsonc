{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pr-legislative-x402",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // See worker/body-parser-stub.ts for why body-parser is replaced.
  "alias": { "body-parser": "./worker/body-parser-stub.ts" },
  "assets": {
    "directory": "./public"
  },
  "triggers": { "crons": [] },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "legislative.r21digital.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
