# ─── Data source (read-only) ─────────────────────────────────────────────
# Neon Postgres connection string for the CivicaPR bills DB.
# USE A READ-ONLY ROLE (GRANT SELECT only). Never the owner/service role.
# Leave BLANK to run on built-in sample data (great for local dev / demos).
DATABASE_URL=

# ─── HTTP server ─────────────────────────────────────────────────────────
PORT=4021

# ─── Payments (x402) ─────────────────────────────────────────────────────
# Default OFF: endpoints are open so you can develop without a wallet.
# Set to "true" to charge per call via x402.
PAYMENTS_ENABLED=false

# Where USDC lands. A Base wallet address YOU control (set this yourself —
# this project never reads or stores a private key on the seller side).
RECEIVING_WALLET_ADDRESS=

# Network for settlement (base = Base mainnet, base-sepolia = testnet).
X402_NETWORK=base

# Coinbase CDP keys, required by the facilitator on mainnet. See x402 docs.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ─── MCP client (buyer side) ─────────────────────────────────────────────
# Base URL the MCP server calls. Point at your deployed API (or localhost).
PR_X402_API_BASE=http://localhost:4021

# ONLY the MCP/agent side needs a spending wallet. Leave blank to call an
# open (PAYMENTS_ENABLED=false) server with no payment. When set, the MCP
# auto-pays 402s from THIS wallet — use a low-balance, dedicated key.
WALLET_PRIVATE_KEY=
